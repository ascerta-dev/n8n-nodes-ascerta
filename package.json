{
	"name": "@ascerta/n8n-nodes-ascerta",
	"version": "1.0.5",
	"description": "n8n community node for routing LLM requests through Ascerta proxy with cost tracking and budget enforcement",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"ascerta",
		"llm",
		"ai",
		"cost-tracking",
		"proxy"
	],
	"license": "MIT",
	"homepage": "https://github.com/ascerta-dev/n8n-nodes-ascerta",
	"author": {
		"name": "Ascerta",
		"email": "support@ascerta.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ascerta-dev/n8n-nodes-ascerta"
	},
	"main": "dist/nodes/Ascerta/Ascerta.node.js",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc && node scripts/copy-icons.js",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lint:fix": "eslint nodes credentials --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AscertaApi.credentials.js",
			"dist/credentials/AscertaDatabricksApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Ascerta/Ascerta.node.js",
			"dist/nodes/Ascerta/AscertaChatModel.node.js",
			"dist/nodes/Ascerta/AscertaChatModelAnthropic.node.js",
			"dist/nodes/Ascerta/AscertaChatModelAzure.node.js",
			"dist/nodes/Ascerta/AscertaChatModelBedrock.node.js",
			"dist/nodes/Ascerta/AscertaChatModelDatabricks.node.js"
		]
	},
	"devDependencies": {
		"@types/node": "^22",
		"eslint": "^10.1.0",
		"n8n-workflow": "*",
		"prettier": "~3.3.0",
		"typescript": "~5.5.0",
		"typescript-eslint": "^8.57.1",
		"vitest": "^4.1.7"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=18"
	}
}
